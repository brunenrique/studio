{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Firebase",
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "scripts": {
    "serve": "npm run build && firebase emulators:start --only functions",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outdir=lib",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.5",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "jsonwebtoken": "^9.0.2",
    "twilio": "^5.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "typescript": "^4.9.0"
  },
  "private": true
}
